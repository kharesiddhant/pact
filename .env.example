# Copy this file to .env.local and fill in both values.
# Find them in your Supabase project: click "Connect" at the top of the dashboard,
# or open Settings > API Keys. Use the publishable key (sb_publishable_...),
# never the secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
